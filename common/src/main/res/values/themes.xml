<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The API 19 theme (head unit / CS11).

        The parent used to be `android:Theme.Material.NoActionBar`, which does not exist before API 21:
        the platform silently falls back to a default theme and every Material attribute below is lost.
        `colorAccent`, `statusBarColor`, `navigationBarColor` and `windowLightStatusBar` are API 21/23 as
        well, so they live in values-v21/themes.xml now.

        `windowBackground` has to be a **drawable**, not `@color/...`: on 4.4 `Resources.loadDrawable`
        rejects a colour with `Resources$NotFoundException: Resource is not a Drawable (color or path)` —
        the warning that kept appearing in the car's logcat from `FrameLayout.<init>`. API 21+ wraps a
        colour into a ColorDrawable, which is why this only ever broke on the head unit.
    -->
    <style name="Theme.Xcertplay" parent="android:Theme.Holo.NoActionBar">
        <!-- No activity open/close animation: the app moves between its own screens instantly, and the
             CarPlay host is only a hidden step of a connect. -->
        <item name="android:windowAnimationStyle">@style/NoWindowAnimation</item>
        <item name="android:fontFamily">sans</item>
        <!--
            Transparent, not a colour.

            A window background can only be one fixed resource, while this app paints its own background per
            screen from the runtime palette (light or dark). Giving the window a dark fill made the light-themed
            screens look like they had switched to night mode - the connecting screen over CarPlay video in
            particular, where the window showed through around the panel. Transparent lets each screen own its
            surface, which is also what the app looked like before the `@color` reference here was fixed to a
            real drawable.
        -->
        <item name="android:windowBackground">@drawable/diplay_window_transparent</item>
        <!--
            A head unit has no status bar: the CS11 gives DiPlay a 1280x650 window above its own dock. On a
            plain device (the API 19 emulator used for visual checks) the status bar would otherwise take
            24 dp off the top of every page, which is not the window this layout was drawn for.
        -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- CarPlay host: no starting window. The host is launched from the home page during a connect and the
         preview window would be an opaque black frame over the home page until the session owns the
         screen. Disabling it lets the home page stay visible while the bring-up starts.
    -->
    <style name="Theme.Xcertplay.Host" parent="Theme.Xcertplay">
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- A window that must not animate in or out: the CarPlay host is invisible during a from-home connect. -->
    <style name="NoWindowAnimation" parent="" />

    <style name="Theme.AdbCluster" parent="android:Theme.Holo.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@drawable/diplay_window_transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>




