<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional, user-authorized startup of the car's own hotspot. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Optional: the dashboard map as a card over the home screen. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <application>
        <provider
            android:name="com.shilapi.xcertplay.DiagnosticReportProvider"
            android:authorities="${applicationId}.diagnostic-reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostic_report_paths" />
        </provider>
        <!--
            The instrument cluster's album cover, read by the head unit's own processes (the DIM
            service and the car's media centre) across a process boundary. It is exported because
            those readers have to resolve the authority at all; access is still per-Uri, granted by
            `VendorClusterBridge` for each cover it hands over (docs/_digest/45 G5). The authority
            must stay `<applicationId>.artwork`: the bridge builds the Uri from `getPackageName()`.
        -->
        <provider
            android:name="com.shilapi.xcertplay.ClusterArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true"
            android:grantUriPermissions="true" />
        <activity android:name="com.shilapi.xcertplay.DiPlayActivity"
            android:exported="true" android:launchMode="singleTop"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Xcertplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="com.shilapi.xcertplay.DiPlaySessionService"
            android:exported="false" />

        <activity
            android:name="com.shilapi.xcertplay.CarPlayHostActivity"
            android:taskAffinity="${applicationId}.carplay"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.Xcertplay.Host"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <activity
            android:name="com.shilapi.xcertplay.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Xcertplay" />

        <activity
            android:name="com.shilapi.xcertplay.ImageCropActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.Xcertplay" />

        <!-- CarPlay navigation widget, for launchers that host standard widgets. -->
        <receiver
            android:name="com.shilapi.xcertplay.NavigationWidget"
            android:exported="false"
            android:label="@string/navigation_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/navigation_widget_info" />
        </receiver>

        <receiver
            android:name="com.shilapi.xcertplay.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            CS11 / Android 4.4: steering-wheel media keys arrive as MEDIA_BUTTON broadcasts.
            The priority is the one playtool 1.6 uses (2147483647) so this manifest receiver wins
            against any other manifest receiver for the same key; the explicit
            AudioManager.registerMediaButtonEventReceiver in CarPlayMediaKeys still decides between
            this receiver and a dynamically registered one (the media centre registers its own when
            an app calls requestPlay).
        -->
        <receiver
            android:name="com.shilapi.xcertplay.MediaButtonReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="2147483647">
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.shilapi.xcertplay.UsbAutoConfirmService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/usb_auto_confirm_service_config" />
        </service>
    </application>

</manifest>


